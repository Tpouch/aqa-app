# Copy to .env (gitignored).

# Web UI login. At least 12 characters.
ADMIN_PASSWORD=change-me-please
# Signs session cookies and firmware download links. At least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Public URL the boards reach (used in OTA download links).
PUBLIC_URL=https://sensor.devgoblin.fr
# Delete measurements older than N days (0 = keep everything).
RETENTION_DAYS=0
# Hosts the alert webhook may post to (comma-separated hostnames, nothing else). Empty = webhook off.
# WEBHOOK_ALLOWED_HOSTS=hermes-hooks.example.com
# Time zone agents use for "today" and for timestamps in their answers.
# AQA_TZ=Europe/Paris
# LOG_LEVEL=info

